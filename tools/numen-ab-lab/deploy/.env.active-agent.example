# 主动行为循环守护进程环境变量
# 复制为 .env.active-agent 并填写（勿提交）

# 连接的目标服务器（正式服 MCP 默认 127.0.0.1:25567；隔离服为 25585）
NUMEN_MCP_URL=http://127.0.0.1:25567/mcp
# 目标服务器 server_control.json 中 principals[0].token（与 MCP 端一致）
NUMEN_MCP_TOKEN=

# 模型端点：二选一，不要同时依赖
# 模式 A（云端，默认）：DeepSeek 官方 API Key（模型直连，不经本地 proxy）
NUMEN_DEEPSEEK_KEY=
# 模式 B（本地，LM Studio / Ollama）：注释掉上面的 DeepSeek key，
# 取消下面两行的注释并指向本地推理端点（OpenAI 兼容 /v1/chat/completions）
# NUMEN_LLM_URL=http://127.0.0.1:1234/v1/chat/completions
# NUMEN_LLM_MODEL=qwen2.5-9b-instruct   # 改为你在 LM Studio 加载的模型名

# 可选：覆盖模型端点/模型名（默认 https://api.deepseek.com/v1/chat/completions + deepseek-v4-flash）
# NUMEN_LLM_URL=
# NUMEN_LLM_MODEL=
