# 主动行为循环守护进程环境变量
# 复制为 .env.active-agent 并填写（勿提交）
# 连接的目标服务器（正式服 MCP 默认 127.0.0.1:25567；隔离服为 25585）
NUMEN_MCP_URL=http://127.0.0.1:25567/mcp
# 目标服务器 server_control.json 中 principals[0].token（与 MCP 端一致）
NUMEN_MCP_TOKEN=
# DeepSeek 官方 API Key（模型直连，不经本地 proxy）
NUMEN_DEEPSEEK_KEY=
# 可选：模型端点覆盖（默认 https://api.deepseek.com/v1/chat/completions）
# NUMEN_LLM_URL=
# 可选：模型名（默认 deepseek-v4-flash）
# NUMEN_LLM_MODEL=
